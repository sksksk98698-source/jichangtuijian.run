{
  "name": "jichangtuijian-run",
  "version": "1.0.0",
  "description": "机场推荐网 (jichangtuijian.run) - 2026专业评测、排行榜、选机对比与优惠情报知识图谱",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev src",
    "generate:pages": "node --experimental-strip-types scripts/generate-pages.ts",
    "generate:rss": "node --experimental-strip-types scripts/generate-rss.ts",
    "seo:check": "node --experimental-strip-types scripts/seo-health-check.ts",
    "indexnow": "node --experimental-strip-types scripts/indexnow.ts",
    "build": "npm run generate:rss && vitepress build src && pagefind --site src/.vitepress/dist && npm run seo:check",
    "build:no-search": "vitepress build src",
    "preview": "vitepress preview src",
    "index:search": "pagefind --site src/.vitepress/dist"
  },
  "keywords": [
    "机场推荐",
    "稳定机场推荐",
    "性价比机场",
    "IEPL机场",
    "IPLC机场",
    "ChatGPT机场",
    "Netflix解锁"
  ],
  "author": "jichangtuijian.run",
  "license": "ISC",
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "pagefind": "^1.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "vitepress": "^1.6.3"
  }
}
